# Comma-separated list of GitHub doc repos to ingest
# Add or remove repos as needed — any public percona/* doc repo works
REPOS=percona/psmysql-docs,percona/pxc-docs,percona/pxb-docs,percona/pdmysql-docs,percona/ps-binlog-server-docs,percona/pmm-doc,percona/k8sps-docs,percona/k8spxc-docs,percona/percona-valkey-doc,percona/pg_tde,percona/pgsm-docs,percona/pcsm-docs,percona/percona-toolkit,percona/pmm_dump_docs,percona/repo-config-docs,openeverest/everest-doc

# Base directory for cloned repos and ChromaDB persistence
# Default: ./data (relative to project root)
DATA_DIR=./data

# Auto-refresh: re-ingest docs if older than N days (on MCP server startup)
# Set to 0 to disable auto-refresh
REFRESH_DAYS=7

# Community content ingestion (Percona blog + forums).
# Set to false to skip; first-run forum ingest takes several hours.
INGEST_BLOG=true
INGEST_FORUM=true

# Base URLs (override only for testing against mirrors)
BLOG_BASE_URL=https://percona.community
FORUM_BASE_URL=https://forums.percona.com

# Polite delay between HTTP requests to community sites (seconds)
COMMUNITY_REQUEST_DELAY=1.0
