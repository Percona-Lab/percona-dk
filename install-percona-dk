#!/bin/bash
# Percona DK Installer
# Usage: curl -fsSL https://raw.githubusercontent.com/Percona-Lab/percona-dk/main/install-percona-dk | bash
#
# Installs Percona Developer Knowledge MCP server and wires it up
# to Claude Desktop and/or Claude Code automatically.
# Safe to re-run: detects existing installs and preserves config.

set -e

# When piped from curl, bash stdin is the pipe — not the terminal.
# Re-fetch and exec with /dev/tty as stdin so interactive prompts work.
SCRIPT_URL="https://raw.githubusercontent.com/Percona-Lab/percona-dk/main/install-percona-dk"
if [ ! -t 0 ]; then
  exec bash <(curl -fsSL "$SCRIPT_URL") </dev/tty
fi

GREEN='\033[0;32m'
RED='\033[0;31m'
YELLOW='\033[0;33m'
BOLD='\033[1m'
DIM='\033[2m'
NC='\033[0m'

ok()   { printf "  ${GREEN}✓${NC} %s\n" "$1"; }
warn() { printf "  ${YELLOW}!${NC} %s\n" "$1"; }
fail() { printf "  ${RED}✗${NC} %s\n" "$1"; exit 1; }
info() { printf "  ${DIM}%s${NC}\n" "$1"; }

echo ""
echo -e "${BOLD}============================================================"
echo " Percona DK Installer"
echo " Developer Knowledge — Percona docs in your AI assistant"
echo -e "============================================================${NC}"
echo ""

# ── Helpers ──────────────────────────────────────────────────

# ask: sets global REPLY to user input (or default).
# Called directly — never inside $() — to avoid subshell/tty issues.
REPLY=""
ask() {
  local prompt="$1"
  local default="$2"
  printf "  %s [${DIM}%s${NC}]: " "$prompt" "$default" >/dev/tty
  read -r REPLY </dev/tty
  REPLY="${REPLY:-$default}"
}

confirm() {
  local prompt="$1"
  local default="${2:-y}"
  local hint
  if [ "$default" = "y" ]; then hint="Y/n"; else hint="y/N"; fi
  printf "  %s (%s): " "$prompt" "$hint" >/dev/tty
  local answer
  read -r answer </dev/tty
  answer="${answer:-$default}"
  [[ "$answer" =~ ^[Yy] ]]
}

inject_mcp_config() {
  local config_file="$1"
  local python_bin="$2"
  local dotenv_path="$3"

  if [ ! -f "$config_file" ]; then
    mkdir -p "$(dirname "$config_file")"
    echo '{}' > "$config_file"
  fi

  "$python_bin" - "$config_file" "$dotenv_path" <<'PYEOF'
import json, sys

config_file = sys.argv[1]
dotenv_path = sys.argv[2]

with open(config_file, "r") as f:
    try:
        config = json.load(f)
    except json.JSONDecodeError:
        config = {}

config.setdefault("mcpServers", {})
config["mcpServers"]["percona-dk"] = {
    "command": sys.executable,
    "args": ["-m", "percona_dk.mcp_server"],
    "env": {"DOTENV_PATH": dotenv_path},
}

with open(config_file, "w") as f:
    json.dump(config, f, indent=2)
    f.write("\n")
PYEOF
}

# ── Install uv ────────────────────────────────────────────────

install_uv() {
  if command -v uv &>/dev/null; then
    ok "uv ($(uv --version))"
    return
  fi

  warn "uv not found — installing..."
  case "$(uname -s)" in
    Darwin|Linux)
      curl -LsSf https://astral.sh/uv/install.sh | sh
      export PATH="$HOME/.local/bin:$HOME/.cargo/bin:$PATH"
      ;;
    *)
      fail "Unsupported OS — install uv manually from https://docs.astral.sh/uv/"
      ;;
  esac

  if command -v uv &>/dev/null; then
    ok "uv installed ($(uv --version))"
  else
    fail "uv installation failed — install manually from https://docs.astral.sh/uv/"
  fi
}

# ── Check Git ─────────────────────────────────────────────────

check_git() {
  if command -v git &>/dev/null; then
    ok "Git ($(git --version | awk '{print $3}'))"
    return
  fi

  warn "Git not found — installing..."
  case "$(uname -s)" in
    Darwin) xcode-select --install 2>/dev/null || fail "Install Git from https://git-scm.com" ;;
    Linux)
      if command -v apt-get &>/dev/null; then sudo apt-get install -y git
      elif command -v dnf &>/dev/null; then sudo dnf install -y git
      else fail "Install Git from https://git-scm.com"
      fi
      ;;
    *) fail "Install Git from https://git-scm.com" ;;
  esac
  ok "Git installed"
}

# ── Detect Claude config paths (OS-aware) ────────────────────

detect_claude_desktop_config() {
  case "$(uname -s)" in
    Darwin) echo "$HOME/Library/Application Support/Claude/claude_desktop_config.json" ;;
    Linux)  echo "$HOME/.config/Claude/claude_desktop_config.json" ;;
    *)      echo "" ;;
  esac
}

# ── Live repo estimates (parallel fetch) ─────────────────────
# Fetches .md file counts from the GitHub trees API for all repos
# simultaneously, then derives time estimates from the counts.
# Results stored as REPO_EST_<owner>_<repo> variables.

TMPDIR_ESTIMATES=$(mktemp -d)
trap 'rm -rf "$TMPDIR_ESTIMATES"' EXIT INT TERM

_fetch_one() {
  local slug="$1"
  local owner="${slug%%/*}"
  local repo="${slug##*/}"
  local outfile="$TMPDIR_ESTIMATES/${owner}_${repo}"

  local result
  result=$(curl -sf --max-time 8 \
    "https://api.github.com/repos/${owner}/${repo}/git/trees/HEAD?recursive=1" \
    2>/dev/null) || { echo "?" > "$outfile"; return; }

  python3 - "$result" <<'PYEOF' > "$outfile"
import json, sys, math
try:
    data = json.loads(sys.argv[1])
    md_count = sum(1 for f in data.get("tree", []) if f["path"].endswith(".md"))
    est_min = max(1, math.ceil(md_count * 7.5 / 1000))
    print(f"{md_count} docs, ~{est_min} min")
except Exception:
    print("?")
PYEOF
}

preload_estimates() {
  # Launch all fetches in parallel
  for slug in "$@"; do
    _fetch_one "$slug" &
  done
  wait  # collect all background jobs
}

get_estimate() {
  local slug="$1"
  local owner="${slug%%/*}"
  local repo="${slug##*/}"
  local outfile="$TMPDIR_ESTIMATES/${owner}_${repo}"
  cat "$outfile" 2>/dev/null || echo "?"
}

# Extract just the minute number from an estimate string
_est_mins() {
  local est="$1"
  python3 -c "import re,sys; m=re.search(r'~(\d+) min','$est'); print(m.group(1) if m else 1)"
}

# ── Prerequisites ─────────────────────────────────────────────

echo -e "${BOLD}Checking prerequisites...${NC}"
echo ""

check_git
install_uv

echo ""

# ── Choose install location ───────────────────────────────────

DEFAULT_DIR="$HOME/percona-dk"

# Detect previous install
if [ -d "$HOME/percona-dk/.git" ]; then
  DEFAULT_DIR="$HOME/percona-dk"
fi

ask "Install directory" "$DEFAULT_DIR"
INSTALL_DIR="${REPLY/#\~/$HOME}"

IS_UPDATE=false
if [ -d "$INSTALL_DIR/.git" ]; then
  IS_UPDATE=true
fi

echo ""

# ── Clone or update repo ──────────────────────────────────────

REPO_URL="https://github.com/Percona-Lab/percona-dk.git"

if [ "$IS_UPDATE" = true ]; then
  echo -e "${BOLD}Updating existing installation...${NC}"
  echo ""
  git -C "$INSTALL_DIR" pull --quiet
  ok "Updated to latest version"
else
  echo -e "${BOLD}Cloning repository...${NC}"
  echo ""
  git clone --quiet "$REPO_URL" "$INSTALL_DIR"
  ok "Repository cloned to $INSTALL_DIR"
fi

echo ""

# ── Create virtual environment and install ────────────────────

echo -e "${BOLD}Setting up Python environment...${NC}"
echo ""

VENV_DIR="$INSTALL_DIR/.venv"
uv venv "$VENV_DIR" --python 3.12 --clear --quiet
ok "Virtual environment ready (Python 3.12)"

uv pip install --quiet -e "$INSTALL_DIR" --python "$VENV_DIR/bin/python"
ok "percona-dk installed"

PYTHON_BIN="$VENV_DIR/bin/python"

echo ""

# ── Configure .env ────────────────────────────────────────────

DOTENV_PATH="$INSTALL_DIR/.env"
[ ! -f "$DOTENV_PATH" ] && cp "$INSTALL_DIR/.env.example" "$DOTENV_PATH"

# Read existing REPOS from .env so we can show current config on re-run
EXISTING_REPOS=$(grep "^REPOS=" "$DOTENV_PATH" 2>/dev/null | cut -d= -f2- || echo "")

# ── Preload live repo estimates in parallel ───────────────────

ALL_REPO_SLUGS=(
  percona/psmysql-docs percona/pxc-docs percona/pxb-docs percona/pmm-doc
  percona/psmdb-docs percona/pbm-docs percona/k8spsmdb-docs
  percona/postgresql-docs percona/k8sppg-docs
  percona/percona-toolkit-doc percona/everest-doc
  percona/proxysql-admin-tool-doc percona/k8sps-docs percona/k8spxc-docs
)

echo -e "${BOLD}Fetching repo info from GitHub...${NC}"
echo ""
preload_estimates "${ALL_REPO_SLUGS[@]}"
ok "Repo info ready"
echo ""

# ── Choose repos by stack ─────────────────────────────────────

# Returns 0 (true) if slug is in EXISTING_REPOS
is_configured() {
  [[ ",$EXISTING_REPOS," == *",$1,"* ]]
}

if [ "$IS_UPDATE" = true ] && [ -n "$EXISTING_REPOS" ]; then
  echo -e "${BOLD}Configured repos${NC}"
  echo ""
  # Pretty-print current repos one per line
  echo "$EXISTING_REPOS" | tr ',' '\n' | while read -r r; do
    [ -n "$r" ] && info "  $r"
  done
  echo ""
  info "Already-indexed repos default to Y. New repos default to N."
  echo ""
fi

echo -e "${BOLD}Choose documentation repos to index${NC}"
echo ""
info "Select the Percona products you work with."
info "Times are approximate on Apple Silicon — Linux may be slower."
echo ""

SELECTED_REPOS=()

# Helper: prompt for a whole stack or individual repos.
# Per-repo default is Y if already in EXISTING_REPOS, else the hardcoded default.
# Stack-level "yes to all" defaults to Y only if every repo in the stack is configured.
select_stack() {
  local stack_name="$1"
  shift
  local entries=("$@")

  # Calculate stack total estimate and check if all are already configured
  local stack_total=0
  local all_configured=true
  for entry in "${entries[@]}"; do
    local slug="${entry%%|*}"
    local est
    est=$(get_estimate "$slug")
    local mins
    mins=$(_est_mins "$est")
    stack_total=$((stack_total + mins))
    is_configured "$slug" || all_configured=false
  done

  local stack_default="n"
  $all_configured && stack_default="y"

  echo -e "  ${BOLD}${stack_name}${NC} ${DIM}(~${stack_total} min total)${NC}"

  if confirm "  Index entire ${stack_name}?" "$stack_default"; then
    for entry in "${entries[@]}"; do
      local slug="${entry%%|*}"
      local rest="${entry#*|}"
      local name="${rest%%|*}"
      local est
      est=$(get_estimate "$slug")
      ok "  $name ($est)"
      SELECTED_REPOS+=("$slug")
    done
  else
    for entry in "${entries[@]}"; do
      local slug="${entry%%|*}"
      local rest="${entry#*|}"
      local name="${rest%%|*}"
      local hardcoded_default="${rest##*|}"
      local est
      est=$(get_estimate "$slug")
      # Already configured repos default to Y; new repos use hardcoded default
      local repo_default="$hardcoded_default"
      is_configured "$slug" && repo_default="y"
      if confirm "    Index $name? ($est)" "$repo_default"; then
        SELECTED_REPOS+=("$slug")
      fi
    done
  fi
  echo ""
}

select_stack "MySQL stack" \
  "percona/psmysql-docs|Percona Server for MySQL|y" \
  "percona/pxc-docs|XtraDB Cluster|y" \
  "percona/pxb-docs|XtraBackup|y" \
  "percona/pmm-doc|PMM (Percona Monitoring and Management)|y"

select_stack "MongoDB stack" \
  "percona/psmdb-docs|Percona Server for MongoDB|n" \
  "percona/pbm-docs|Percona Backup for MongoDB|n" \
  "percona/k8spsmdb-docs|Kubernetes Operator for MongoDB|n"

select_stack "PostgreSQL stack" \
  "percona/postgresql-docs|Percona Distribution for PostgreSQL|n" \
  "percona/k8sppg-docs|Kubernetes Operator for PostgreSQL|n"

select_stack "Platform and Tools" \
  "percona/percona-toolkit-doc|Percona Toolkit|n" \
  "percona/everest-doc|Percona Everest (DBaaS)|n" \
  "percona/proxysql-admin-tool-doc|ProxySQL Admin Tool|n" \
  "percona/k8sps-docs|Kubernetes Operator for MySQL|n" \
  "percona/k8spxc-docs|Kubernetes Operator for PXC|n"

if [ ${#SELECTED_REPOS[@]} -eq 0 ]; then
  warn "No repos selected — defaulting to percona/psmysql-docs"
  SELECTED_REPOS=("percona/psmysql-docs")
fi

REPOS_VALUE=$(IFS=,; echo "${SELECTED_REPOS[*]}")
ok "${#SELECTED_REPOS[@]} repo(s) selected"
echo ""

# ── Choose sync frequency ─────────────────────────────────────

EXISTING_REFRESH=$(grep "^REFRESH_DAYS=" "$DOTENV_PATH" 2>/dev/null | cut -d= -f2- || echo "7")

echo -e "${BOLD}Auto-sync frequency${NC}"
echo ""
info "Percona DK re-indexes docs in the background when the MCP server"
info "starts and data is older than the configured threshold."
echo ""

ask "Re-index docs every N days (0 to disable)" "$EXISTING_REFRESH"
REFRESH_DAYS="$REPLY"

echo ""

# ── Write .env ────────────────────────────────────────────────

"$PYTHON_BIN" - "$DOTENV_PATH" "$REPOS_VALUE" "$REFRESH_DAYS" <<'PYEOF'
import re, pathlib, sys

env_path = pathlib.Path(sys.argv[1])
repos    = sys.argv[2]
refresh  = sys.argv[3]

text = env_path.read_text()
text = re.sub(r"^REPOS=.*",        f"REPOS={repos}",         text, flags=re.MULTILINE)
text = re.sub(r"^REFRESH_DAYS=.*", f"REFRESH_DAYS={refresh}", text, flags=re.MULTILINE)
env_path.write_text(text)
PYEOF

ok ".env configured"
echo ""

# ── Wire up MCP config ────────────────────────────────────────

echo -e "${BOLD}Connecting to AI clients...${NC}"
echo ""

WIRED_ANYTHING=false

CLAUDE_DESKTOP_CONFIG=$(detect_claude_desktop_config)
if [ -n "$CLAUDE_DESKTOP_CONFIG" ]; then
  if [ -d "$(dirname "$CLAUDE_DESKTOP_CONFIG")" ] || confirm "Configure Claude Desktop?" "y"; then
    inject_mcp_config "$CLAUDE_DESKTOP_CONFIG" "$PYTHON_BIN" "$DOTENV_PATH"
    ok "Claude Desktop configured"
    WIRED_ANYTHING=true
  fi
fi

CLAUDE_CODE_CONFIG="$HOME/.claude/settings.json"
if [ -f "$CLAUDE_CODE_CONFIG" ] || confirm "Configure Claude Code (CLI)?" "y"; then
  inject_mcp_config "$CLAUDE_CODE_CONFIG" "$PYTHON_BIN" "$DOTENV_PATH"
  ok "Claude Code configured"
  WIRED_ANYTHING=true
fi

echo ""

# ── Run initial ingestion ─────────────────────────────────────

CHROMA_DIR="$INSTALL_DIR/data/chroma"

echo -e "${BOLD}Indexing documentation...${NC}"
echo ""

if [ -d "$CHROMA_DIR" ]; then
  ok "Documentation index already exists"
  info "Auto-refresh is enabled — docs will re-index in the background every ${REFRESH_DAYS} day(s)."
  echo ""
  if ! confirm "Re-index now anyway?" "n"; then
    SKIP_INGEST=true
  fi
  echo ""
fi

if [ "${SKIP_INGEST:-false}" = false ]; then
  # Sum estimates for selected repos
  EST_TOTAL=0
  if [ -n "${SELECTED_REPOS+x}" ]; then
    for slug in "${SELECTED_REPOS[@]}"; do
      est=$(get_estimate "$slug")
      mins=$(_est_mins "$est")
      EST_TOTAL=$((EST_TOTAL + mins))
    done
  fi

  info "Downloads and indexes selected repos — roughly ${EST_TOTAL}+ min on Apple Silicon."
  info "This runs once now; future updates happen automatically in the background."
  echo ""

  if confirm "Run initial ingestion now?" "y"; then
    echo ""
    DOTENV_PATH="$DOTENV_PATH" "$VENV_DIR/bin/percona-dk-ingest"
    echo ""
    ok "Documentation indexed"
  else
    echo ""
    warn "Skipped. Run percona-dk-ingest manually before first use:"
    info "  DOTENV_PATH=\"$DOTENV_PATH\" $VENV_DIR/bin/percona-dk-ingest"
  fi
fi

echo ""

# ── Done ──────────────────────────────────────────────────────

echo -e "${BOLD}${GREEN}============================================================"
echo " Percona DK is ready!"
echo -e "============================================================${NC}"
echo ""
ok "Installed to: $INSTALL_DIR"
ok "MCP server: $PYTHON_BIN -m percona_dk.mcp_server"

if [ "$WIRED_ANYTHING" = true ]; then
  echo ""
  echo -e "  ${YELLOW}Restart Claude Desktop / Claude Code for the changes to take effect.${NC}"
fi

echo ""
info "To re-index docs at any time:"
info "  DOTENV_PATH=\"$DOTENV_PATH\" $VENV_DIR/bin/percona-dk-ingest"
echo ""
info "To change repos or sync frequency, edit: $DOTENV_PATH"
info "Then re-run percona-dk-ingest."
echo ""
